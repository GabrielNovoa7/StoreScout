rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
    function validProfile(p) {
      return p is map && p.keys().hasAll(['name', 'zip', 'mode', 'accent'])
        && p.keys().hasOnly(['name', 'zip', 'mode', 'accent'])
        && p.name is string && p.name.size() <= 60
        && p.zip is string && p.zip.matches('^[0-9]{5}$')
        && p.mode in ['light', 'dark', 'system']
        && p.accent in ['green', 'blue', 'purple', 'orange', 'pink'];
    }
    function validReceiptAt(r, i) {
      return r.size() <= i || (r[i] is string && r[i].matches('^[a-zA-Z0-9_-]{1,80}$'));
    }
    function validReceipts(r) {
      return r is list && r.size() <= 20 && r.toSet().size() == r.size()
        && validReceiptAt(r, 0)
        && validReceiptAt(r, 1)
        && validReceiptAt(r, 2)
        && validReceiptAt(r, 3)
        && validReceiptAt(r, 4)
        && validReceiptAt(r, 5)
        && validReceiptAt(r, 6)
        && validReceiptAt(r, 7)
        && validReceiptAt(r, 8)
        && validReceiptAt(r, 9)
        && validReceiptAt(r, 10)
        && validReceiptAt(r, 11)
        && validReceiptAt(r, 12)
        && validReceiptAt(r, 13)
        && validReceiptAt(r, 14)
        && validReceiptAt(r, 15)
        && validReceiptAt(r, 16)
        && validReceiptAt(r, 17)
        && validReceiptAt(r, 18)
        && validReceiptAt(r, 19)
        ;
    }
    function validLocation(l) {
      return l is map && l.keys().hasAll(['id', 'name', 'address'])
        && l.keys().hasOnly(['id', 'name', 'address'])
        && l.id is string && l.id.matches('^[A-Za-z0-9_-]{1,80}$')
        && l.name is string && l.name.size() <= 120
        && l.address is string && l.address.size() <= 200;
    }
    function validLocations(m) {
      return m is map && m.keys().hasOnly(['kroger', 'heb', 'walmart', 'sellers'])
        && (!('kroger' in m) || validLocation(m.kroger))
        && (!('heb' in m) || validLocation(m.heb))
        && (!('walmart' in m) || validLocation(m.walmart))
        && (!('sellers' in m) || validLocation(m.sellers));
    }
    function validList() {
      let d = request.resource.data;
      return d.keys().hasAll(['schema', 'state', 'revision', 'updatedAt'])
        && d.keys().hasOnly(['schema', 'state', 'revision', 'updatedAt'])
        && d.schema == 1
        && d.revision is int && d.revision > 0
        && d.updatedAt == request.time
        && d.state is map
        && d.state.keys().hasAll(['version', 'items', 'stores', 'preferences'])
        && d.state.keys().hasOnly(['version', 'items', 'stores', 'preferences', 'profile', 'importReceipts', 'locations'])
        && (!('profile' in d.state) || validProfile(d.state.profile))
        && (!('importReceipts' in d.state) || validReceipts(d.state.importReceipts))
        && (!('locations' in d.state) || validLocations(d.state.locations))
        && d.state.version == 1
        && d.state.items is list && d.state.items.size() <= 200
        && d.state.stores is list && d.state.stores.size() <= 4
        && d.state.stores.hasOnly(['heb', 'walmart', 'kroger', 'sellers'])
        && d.state.preferences is map && d.state.preferences.size() <= 200;
    }
    match /users/{uid}/lists/main {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && validList() && request.resource.data.revision == 1;
      allow update: if isOwner(uid) && validList()
        && request.resource.data.revision == resource.data.revision + 1;
      // No collection listing, sharing, or client deletion in this increment.
    }
    match /{document=**} { allow read, write: if false; }
  }
}
