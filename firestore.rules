rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
    function validList() {
      let d = request.resource.data;
      return d.keys().hasAll(['schema', 'state', 'revision', 'updatedAt'])
        && d.keys().hasOnly(['schema', 'state', 'revision', 'updatedAt'])
        && d.schema == 1
        && d.revision is int && d.revision > 0
        && d.updatedAt == request.time
        && d.state is map
        && d.state.keys().hasAll(['version', 'items', 'stores', 'preferences'])
        && d.state.keys().hasOnly(['version', 'items', 'stores', 'preferences'])
        && d.state.version == 1
        && d.state.items is list && d.state.items.size() <= 200
        && d.state.stores is list && d.state.stores.size() <= 2
        && d.state.stores.hasOnly(['heb', 'walmart'])
        && d.state.preferences is map && d.state.preferences.size() <= 200;
    }
    match /users/{uid}/lists/main {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && validList() && request.resource.data.revision == 1;
      allow update: if isOwner(uid) && validList()
        && request.resource.data.revision == resource.data.revision + 1;
      // No collection listing, sharing, or client deletion in this increment.
    }
    match /{document=**} { allow read, write: if false; }
  }
}
